package helloworld.variables;

public class DemoVariables10 {

    public static void main(String[] args) {
        boolean isProgrammingFun = (10 > 5), isProgrammingHard = (10 <= 5);

        System.out.println("The value of isProgrammingFun is "
                + isProgrammingFun);
        System.out.println("The value of isProgrammingHard is "
                + isProgrammingHard);
    }
}